<?xml version="1.0" encoding="utf-8"?>
<!--
    podatui.msi — built by build-msi.ps1 from a make-dist.ps1 folder:
        wix build podatui.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
            -d DistDir=<dist> -d Version=<x.y.z> -o podatui.msi

    Installs to Program Files. The real work (test-signing and installing the two
    drivers, the elevated helper tasks, taking over older installs) is done by
    msi-setup.ps1, the same steps install.ps1 runs for the zip install.
    Settings, logs and heart-rate history stay in %LOCALAPPDATA%\podatui.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="podatui" Manufacturer="LargeModGames" Version="$(Version)"
           UpgradeCode="425B2F81-A2B3-4C87-A996-1F651A30D946"
           Scope="perMachine" Compressed="yes" Language="1033">

    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of podatui is already installed." />
    <!-- Upstream NTPods drives the same AirPods devnode: uninstall its MSI (any version)
         along with older podatui ones. msi-setup.ps1 cleans up what that leaves. -->
    <Upgrade Id="6F0B2D57-4C1E-4E8B-9C2F-6E7A1D3B5A90">
      <UpgradeVersion Property="NTPODSPRODUCTS" Minimum="0.0.0" IncludeMinimum="yes" />
    </Upgrade>
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="PodatuiIcon" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="PodatuiIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/LargeModGames/podatui" />
    <Property Id="ARPHELPLINK" Value="https://github.com/LargeModGames/podatui/issues" />

    <!-- The drivers are test-signed, so Windows only loads them in Test Mode. -->
    <Property Id="BOOTOPTIONS">
      <RegistrySearch Id="BootOptions" Root="HKLM" Key="SYSTEM\CurrentControlSet\Control"
                      Name="SystemStartOptions" Type="raw" />
    </Property>
    <Launch Condition="Installed OR (BOOTOPTIONS ~&gt;&lt; &quot;TESTSIGNING&quot;)"
            Message="Test Mode is not on, so Windows would refuse to load the podatui drivers.&#13;&#10;&#13;&#10;1. If BitLocker is on, save your recovery key first (https://aka.ms/myrecoverykey or: manage-bde -protectors -get C:). Changing Secure Boot or Test Mode can make Windows ask for it at the next boot.&#13;&#10;2. Turn off Secure Boot in your firmware/BIOS.&#13;&#10;3. In an admin terminal run:  bcdedit /set testsigning on&#13;&#10;4. Reboot (&quot;Test Mode&quot; shows in the bottom-right corner) and run this installer again." />

    <!-- The ACX mic driver only loads on Windows 11 22H2 (build 22621) or newer, so
         the "ACX microphone" feature below only exists there. VersionNT/WindowsBuild
         are frozen for compatibility on Windows 10+, hence the registry. -->
    <Property Id="OSBUILD">
      <RegistrySearch Id="OsBuild" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber" Type="raw" />
    </Property>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="podatui" />
    </StandardDirectory>

    <!-- Everything make-dist.ps1 assembled, except the zip installer itself. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(DistDir)\**">
        <Exclude Files="$(DistDir)\install.ps1" />
      </Files>
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="1C0B3BC3-CB1C-4ADB-9705-06B424517029">
      <Shortcut Id="StartMenuPodatui" Name="podatui" Description="AirPods on Windows"
                Target="[INSTALLFOLDER]winui\podatui-winui.exe" WorkingDirectory="WinuiDir" Icon="PodatuiIcon" />
      <RegistryValue Root="HKLM" Key="Software\podatui" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="D91E3DBF-BD8E-4027-8530-EAE8D514816E">
      <Shortcut Id="DesktopPodatui" Name="podatui" Description="AirPods on Windows"
                Target="[INSTALLFOLDER]winui\podatui-winui.exe" WorkingDirectory="WinuiDir" Icon="PodatuiIcon" />
      <RegistryValue Root="HKLM" Key="Software\podatui" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- The same Run values the app's own "Start with Windows" setting uses, so the
         two stay in sync. -->
    <Component Id="StartWithWindows" Directory="INSTALLFOLDER" Guid="A6ADAA84-C149-47C6-B295-586B51E964F4">
      <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="podatui Daemon"
                     Type="string" Value="&quot;[INSTALLFOLDER]podatuid.exe&quot;" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="podatui"
                     Type="string" Value="&quot;[INSTALLFOLDER]winui\podatui-winui.exe&quot; --tray" />
    </Component>

    <!-- Holds no files: selecting it is what makes msi-setup.ps1 install the drivers. -->
    <Component Id="DriversMarker" Directory="INSTALLFOLDER" Guid="E3415041-2299-42A8-8792-1ADE426B3D04">
      <RegistryValue Root="HKLM" Key="Software\podatui" Name="Drivers" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Holds no files: selected = ACX mic, not selected = PortCls mic. -->
    <Component Id="MicAcxMarker" Directory="INSTALLFOLDER" Guid="012AE2A9-87FC-411D-8EB7-D4771E66B64C">
      <RegistryValue Root="HKLM" Key="Software\podatui" Name="MicAcx" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <DirectoryRef Id="INSTALLFOLDER">
      <Directory Id="WinuiDir" Name="winui" />
    </DirectoryRef>

    <Feature Id="Main" Title="podatui" AllowAbsent="no" Display="expand" ConfigurableDirectory="INSTALLFOLDER"
             Description="The app, its background service and a Start menu entry.">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />

      <Feature Id="Drivers" Title="Drivers"
               Description="The AirPods driver and the podatui microphone, test-signed on this PC. podatui needs them; only leave this off if they are already installed.">
        <ComponentRef Id="DriversMarker" />
        <Feature Id="MicAcx" Title="ACX microphone driver"
                 Description="Use the ACX microphone driver (Windows 11 22H2 and newer). Turn this off to use the PortCls driver instead, the one Windows 10 uses.">
          <Level Value="0" Condition="OSBUILD &lt; 22621" />
          <ComponentRef Id="MicAcxMarker" />
        </Feature>
      </Feature>
      <Feature Id="Desktop" Title="Desktop shortcut" Description="A podatui shortcut on the desktop.">
        <ComponentRef Id="DesktopShortcut" />
      </Feature>
      <Feature Id="Startup" Title="Start with Windows"
               Description="Start podatui in the tray when you sign in. You can change this later in the app's settings.">
        <ComponentRef Id="StartWithWindows" />
      </Feature>
    </Feature>

    <!-- ==== custom actions (msi-setup.ps1, elevated, as SYSTEM) ==== -->
    <!-- Folder properties end in "\", which would escape the closing quote on the
         command line, hence the trailing "." -->

    <SetProperty Action="SetMicAcx" Id="MICDRIVER" Sequence="execute" Before="SetPodatuiInstallDrv"
                 Condition="&amp;MicAcx=3" Value="acx" />
    <SetProperty Action="SetMicPortCls" Id="MICDRIVER" Sequence="execute" Before="SetPodatuiInstallDrv"
                 Condition="NOT (&amp;MicAcx=3)" Value="portcls" />
    <SetProperty Action="SetPodatuiInstallDrv" Id="PodatuiInstall" Sequence="execute" Before="PodatuiInstall"
                 Condition="&amp;Drivers=3" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]msi-setup.ps1&quot; -Action install -UserSid [UserSID] -LocalAppData &quot;[LocalAppDataFolder].&quot; -AppData &quot;[AppDataFolder].&quot; -Drivers -MicDriver [MICDRIVER]" />
    <SetProperty Action="SetPodatuiInstall" Id="PodatuiInstall" Sequence="execute" Before="PodatuiInstall"
                 Condition="NOT (&amp;Drivers=3)" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]msi-setup.ps1&quot; -Action install -UserSid [UserSID] -LocalAppData &quot;[LocalAppDataFolder].&quot; -AppData &quot;[AppDataFolder].&quot;" />
    <SetProperty Id="PodatuiStop" Sequence="execute" Before="PodatuiStop" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]msi-setup.ps1&quot; -Action stop" />
    <SetProperty Id="PodatuiRemoveDrivers" Sequence="execute" Before="PodatuiRemoveDrivers" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]msi-setup.ps1&quot; -Action remove-drivers" />
    <SetProperty Id="PodatuiUninstall" Sequence="execute" Before="PodatuiUninstall" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]msi-setup.ps1&quot; -Action uninstall -UserSid [UserSID] -LocalAppData &quot;[LocalAppDataFolder].&quot; -AppData &quot;[AppDataFolder].&quot;" />

    <CustomAction Id="PodatuiInstall" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="PodatuiStop" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="PodatuiRemoveDrivers" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="PodatuiUninstall" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <!-- Before files are replaced or removed, stop the running copy (the script is
           still there: it is only removed by RemoveFiles). -->
      <Custom Action="PodatuiStop" Before="RemoveFiles" Condition="Installed" />
      <Custom Action="PodatuiRemoveDrivers" After="PodatuiStop"
              Condition="(&amp;Drivers=2) AND (!Drivers=3) AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="PodatuiUninstall" After="PodatuiRemoveDrivers"
              Condition="(REMOVE~=&quot;ALL&quot;) AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="PodatuiInstall" After="InstallFiles" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
      <ScheduleReboot After="InstallFinalize" Condition="(&amp;Drivers=3) AND NOT (REMOVE~=&quot;ALL&quot;)" />
    </InstallExecuteSequence>

    <!-- ==== UI: welcome, notes, feature tree (with install folder), progress ==== -->
    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)License.rtf" />
  </Package>
</Wix>
